{
  "name": "hilo",
  "productName": "Hilo",
  "version": "1.3.2",
  "description": "Gestor de sesiones de Claude Code para Windows",
  "private": true,
  "main": "dist/main/index.js",
  "author": "ivanmaxor",
  "license": "MIT",
  "homepage": "https://github.com/ivanmaxor/Hilo-App",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivanmaxor/Hilo-App.git"
  },
  "bugs": "https://github.com/ivanmaxor/Hilo-App/issues",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && playwright test",
    "dist": "node scripts/build.mjs --prod && electron-builder --win --x64 --publish never",
    "publish-release": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "^0.28.2",
    "preact": "^11.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
